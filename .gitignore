target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# https://maven.apache.org/tools/wrapper/#Usage_with_or_without_Binary_JAR
.mvn/wrapper/maven-wrapper.jar

# Eclipse m2e generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IntelliJ IDEA (shared run configurations live in .run/ and ARE committed)
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Local environment / secrets
# Real values live in .env files (root and every service) - never commit them.
# Only the .env.example templates are committed.
.env
.env.*
!.env.example
# Per-service local overrides, e.g. account-service/config/application.yml (auto-loaded by Spring Boot)
/*/config/

# Claude Code worktrees
.claude/worktrees/
