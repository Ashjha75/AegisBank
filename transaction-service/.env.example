# ==========================================================================
# transaction-service - environment template (committed; placeholders only)
#
# Setup:  cp .env.example .env   (Windows: copy .env.example .env)
# .env is ignored - put real values there, never here.
# Spring Boot loads .env from this folder at startup; real environment
# variables override it. Format: KEY=value, no quotes, no spaces around "=".
# ==========================================================================

# --- Server ----------------------------------------------------------------
SERVER_PORT=8082

# --- PostgreSQL (database: transaction_db) ---------------------------------
DB_HOST=localhost
DB_PORT=5432
# Must match DB_USERNAME / DB_PASSWORD in the root .env (Docker).
DB_USERNAME=aegisuser
DB_PASSWORD=<change-me>

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Downstream services (OpenFeign) -----------------------------------------
ACCOUNT_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8083
