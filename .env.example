# ==========================================================================
# AegisBank - Docker infrastructure settings (used by docker-compose.yml)
#
# Setup:  cp .env.example .env      (Windows: copy .env.example .env)
# Then replace every <change-me> value. .env is git-ignored - never commit it.
# This file IS committed: keep it in sync when you add a variable, but put
# only placeholders here, never real secrets.
#
# docker compose reads .env from this folder automatically.
# Each Spring service has its own <service>/.env - the DB and Redis values
# there must match the ones here.
#
# Syntax: KEY=value, no spaces around "=". Wrap values containing "$" in
# single quotes, e.g. DB_PASSWORD='pa$$word'.
# ==========================================================================

# --- PostgreSQL ------------------------------------------------------------
# One login used by every service. Created only when the postgres-data volume
# is empty; changing these later requires resetting the volume (see README).
DB_USERNAME=aegisuser
DB_PASSWORD=<change-me>
# Default/scratch database. Service databases (account_db, ...) are created
# by docker/postgres/init.
DB_NAME=aegisbankdb
# Host port Postgres is published on.
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
# Required: Redis runs with a password. Generate one: openssl rand -hex 24
REDIS_PASSWORD=<change-me>
REDIS_PORT=6379

# --- Kafka -----------------------------------------------------------------
# Host port for Kafka. Services connect to localhost:<KAFKA_PORT>.
KAFKA_PORT=9092

# --- Adminer (Postgres web UI) --------------------------------------------
ADMINER_PORT=8090
