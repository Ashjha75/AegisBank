# AegisBank frontend configuration. Copy to .env (never commit .env).
# All values are read by the Next.js SERVER at runtime - nothing here is sent to the browser,
# so the same Docker image works in every environment.

# Where the Next.js server reaches the Spring Cloud api-gateway.
# Inside Docker, host.docker.internal is your machine (where the backend runs on :8080).
# On ECS/Render: the gateway's internal URL, e.g. http://api-gateway.internal:8080
API_GATEWAY_URL=http://host.docker.internal:8080

# Give up on a gateway call after this many milliseconds (answers 504 GATEWAY_TIMEOUT).
API_TIMEOUT_MS=15000

# Login for the private docs UI at /v1/admin/docs-ui (HTTP Basic auth).
# Password: at least 12 characters. If either is empty, the docs are OPEN in development and
# DISABLED (503) in production.
DOCS_AUTH_USER=
DOCS_AUTH_PASSWORD=

# Host ports used by compose.yaml (dev server / production preview).
FRONTEND_PORT=3000
FRONTEND_PROD_PORT=3001
