# ==========================================================================
# fraud-detection-service - environment template (committed; placeholders only)
#
# Setup:  cp .env.example .env   (Windows: copy .env.example .env)
# .env is ignored - put real values there, never here.
# Spring Boot loads .env from this folder at startup; real environment
# variables override it. Format: KEY=value, no quotes, no spaces around "=".
# ==========================================================================

# --- Server ----------------------------------------------------------------
SERVER_PORT=8084

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Must match REDIS_PASSWORD in the root .env (Docker).
REDIS_PASSWORD=<change-me>

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Downstream services (OpenFeign) -----------------------------------------
ACCOUNT_SERVICE_URL=http://localhost:8081

# --- Business rules: fraud checks --------------------------------------------
# Velocity: more transfers than this from one account within 60 seconds is suspicious.
FRAUD_MAX_TRANSACTIONS_PER_MINUTE=5
# Amount: a transfer above (account's average transfer x this) is suspicious. Must be >= 1.
FRAUD_SUSPICIOUS_AMOUNT_MULTIPLIER=5.0
# Balance: a transfer above this share of the sender's balance is suspicious (0.90 = 90%).
FRAUD_MAX_BALANCE_PERCENTAGE=0.90
