# ==========================================================================
# notification-service - environment template (committed; placeholders only)
#
# Setup:  cp .env.example .env   (Windows: copy .env.example .env)
# .env is ignored - put real values there, never here.
# Spring Boot loads .env from this folder at startup; real environment
# variables override it. Format: KEY=value, no quotes, no spaces around "=".
# ==========================================================================

# --- Server ----------------------------------------------------------------
SERVER_PORT=8085

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Email (SMTP) - used once spring.mail is enabled in application.yml ------
# Gmail: smtp.gmail.com / 587 / your address / a 16-char App Password
# (Google Account > Security > App passwords), not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<change-me>
MAIL_PASSWORD=<change-me>
